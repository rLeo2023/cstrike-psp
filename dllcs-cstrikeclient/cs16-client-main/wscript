#! /usr/bin/env python
# encoding: utf-8
# Counter-Strike 1.6 client (cs16-client) as a static, relocatable game library.
# On PSP there is no usable dynamic loader, so the client is linked into the
# engine binary and looked up through the exports table (see scripts/waifulib/xshlib.py).

from waflib import Logs, Configure
import os
import re

top = '.'

CLIENT_EXCLUDE = [
	# Windows DirectInput path, replaced by input/input_xash3d.cpp
	'cl_dll/inputw32.cpp',
	# replaced by input/input_sdl.cpp, which is what this build selects
	'cl_dll/ev_hldm.cpp',
	'cl_dll/input/input_sdl.cpp',
	# defines duplicated globals, the real definitions live in cs_weapons.cpp
	'cl_dll/cs_wpn/cs_baseentity.cpp',
]

MINIUTL_EXCLUDE = []

INCLUDES = [
	'cl_dll/include',
	'cl_dll/include/hud',
	'cl_dll/include/studio',
	'cl_dll/include/math',
	'cl_dll',
	'cl_dll/particleman',
	'common',
	'engine',
	'pm_shared',
	'dlls',
	'game_shared',
	'public',
	'public/cl_dll',
	'3rdparty/miniutl',
	'3rdparty/mainui_cpp',
	'3rdparty/mainui_cpp/miniutl',
]

DEFINES = [
	'CLIENT_WEAPONS',
	'CLIENT_DLL',
	'STDINT_H=<cstdint>',
	# MSVC spellings, mapped onto newlib
	'stricmp=strcasecmp',
	'strnicmp=strncasecmp',
